{
  "name": "online-newspaper",
  "version": "1.0.0",
  "private": true,
  "description": "Online newspaper application powered by React, Node.js, and Express",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "client": "npm --prefix client run dev -- --host 0.0.0.0",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production node server/index.js"
  },
  "keywords": [
    "newspaper",
    "react",
    "express",
    "node"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^10.0.0",
    "nodemon": "^3.1.10"
  }
}
